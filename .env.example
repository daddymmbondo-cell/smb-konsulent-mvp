# Database
# Lokalt (Docker Postgres): DIRECT_URL kan være lik DATABASE_URL.
# I produksjon mot Neon: DATABASE_URL = den *poolede* tilkoblingsstrengen
# (host med "-pooler" i navnet, brukes av selve appen), DIRECT_URL = den
# *direkte* tilkoblingsstrengen (brukes kun av `prisma migrate deploy`).
# Se docs/deployment-guide.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smb_konsulent?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smb_konsulent?schema=public"

# Auth.js — generer en tilfeldig verdi, f.eks. med: openssl rand -base64 32
AUTH_SECRET="[GENERER_EN_TILFELDIG_HEMMELIGHET]"
NEXTAUTH_URL="http://localhost:3000"

# E-post (foreløpig ikke i bruk — dev-adapteren logger lokalt)
# RESEND_API_KEY="[SETT_INN_SENERE]"

# Admin-varsling
ADMIN_EMAIL="[ADMIN_EPOST]"

# KI (ikke aktivert i MVP)
# ANTHROPIC_API_KEY="[SETT_INN_SENERE]"
AI_FEATURES_ENABLED="false"

# Microsoft 365 / Graph API (start med gratis Microsoft 365 Developer Program-tenant)
AZURE_AD_CLIENT_ID="[SETT_INN]"
AZURE_AD_CLIENT_SECRET="[SETT_INN]"
AZURE_AD_TENANT_ID="[SETT_INN]"
MICROSOFT_MAILBOX_ADDRESS="[SETT_INN_F.EKS_post@dittdomene.no]"
# Sett til "true" først når appregistreringen har fått admin-samtykke for
# Mail.Send, Mail.ReadWrite og Calendars.ReadWrite (application permissions)
MICROSOFT_INTEGRATION_ENABLED="false"
